Blast4-request ::= {
  body queue-search {
    program "blastn",
    service "plain",
    queries bioseq-set {
      seq-set {
        seq {
          id {
            local str "Query_7648663"
          },
          descr {
            user {
              type str "CFastaReader",
              data {
                {
                  label str "DefLine",
                  data str ">"
                }
              }
            },
            molinfo {
              biomol genomic
            }
          },
          inst {
            repr raw,
            mol dna,
            length 288,
            seq-data ncbi2na '3834130C540D0C0FCDFFF2C9F4834D2C51543D0FCD0430CA
1490490C904CF4D3C824A20F4010C5049FFF3CD24B3D42FF1012453C83C5FFD10D1493903CD0C5
20FFCE2370CE050153'H
          }
        }
      }
    },
    subject database "core_nt",
    algorithm-options {
      {
        name "EvalueThreshold",
        value cutoff e-value { 5, 10, -2 }
      },
      {
        name "UngappedMode",
        value boolean FALSE
      },
      {
        name "PercentIdentity",
        value real { 0, 10, 0 }
      },
      {
        name "HitlistSize",
